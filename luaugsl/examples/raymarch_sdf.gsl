--!shader
--!strict

@binding(0, 0)
const CameraData = uniform
{
    position: vector3,
    direction: vector3,
    resolution: vector2
}

@binding(0, 1)
const SceneData = storageBuffer<SDFObject>

@binding(0, 2)
const OutputImage = storageImage<rgba8>

type SDFObject = { position: vector3, radius: f32, color: vector3, blendFactor: f32 }

function distanceFromPoint(p: vector3, obj: SDFObject): f32
    return length(p - obj.position) - obj.radius
end

function sceneDistance(p: vector3): f32
    local minDist: f32 = 999999.0
    local count: u32 = bufferLength(SceneData)
    for i = 0, count - 1, 1 do
        local obj: SDFObject = bufferLoad(SceneData, i)
        local d: f32 = distanceFromPoint(p, obj)
        local blend: f32 = 0.5 * (d - minDist) / obj.blendFactor
        local h: f32 = max(0.5 - blend, 0.0)
        minDist = mix(minDist, d, h) - h * h * obj.blendFactor * 0.25
    end
    return minDist
end

function calculateNormal(p: vector3): vector3
    local eps: f32 = 0.001
    local dx: f32 = sceneDistance(p + vector3.create(eps, 0.0, 0.0)) - sceneDistance(p - vector3.create(eps, 0.0, 0.0))
    local dy: f32 = sceneDistance(p + vector3.create(0.0, eps, 0.0)) - sceneDistance(p - vector3.create(0.0, eps, 0.0))
    local dz: f32 = sceneDistance(p + vector3.create(0.0, 0.0, eps)) - sceneDistance(p - vector3.create(0.0, 0.0, eps))
    return normalize(vector3.create(dx, dy, dz))
end

@stage("postprocess")
export function main(@builtin("globalInvocationId") globalId: vector3u)
    local coord: vector2i = vector2i.create(globalId.x, globalId.y)
    local uvX: f32 = coord.x / CameraData.resolution.x
    local uvY: f32 = coord.y / CameraData.resolution.y

    local ro: vector3 = CameraData.position
    local rd: vector3 = normalize(CameraData.direction + vector3.create(uvX - 0.5, uvY - 0.5, 0.0))

    local t: f32 = 0.0
    local hit: boolean = false
    for i = 0, 64, 1 do
        local p: vector3 = ro + rd * t
        local d: f32 = sceneDistance(p)
        if d < 0.001 then
            hit = true
            break
        end
        t = t + d
        if t > 100.0 then
            break
        end
    end

    local outColor: vector3
    if hit then
        local p: vector3 = ro + rd * t
        local n: vector3 = calculateNormal(p)
        local lightDir: vector3 = normalize(vector3.create(0.5, 1.0, 0.3))
        local NdotL: f32 = max(dot(n, lightDir), 0.0)
        local ambient: f32 = 0.2
        outColor = vector3.create(0.8, 0.5, 0.3) * (NdotL + ambient)
    else
        local skyFactor: f32 = 1.0 - uvY
        outColor = vector3.create(0.5, 0.7, 1.0) * skyFactor
    end

    local final: vector4 = vector4.create(outColor.x, outColor.y, outColor.z, 1.0)
    imageWrite(OutputImage, coord, final)
end
